 /* AR0822 default setting for 4 data lanes and data frequency 800 MHz */
 static u32 ar0822_code_list[] = {
 	MEDIA_BUS_FMT_UYVY8_1X16,
+	MEDIA_BUS_FMT_Y8_1X8,
