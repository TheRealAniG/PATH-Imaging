diff --git a/drivers/media/i2c/tevs/tevs_main.c b/drivers/media/i2c/tevs/tevs_main.c
index 0929aa2..e48f762 100644
--- a/drivers/media/i2c/tevs/tevs_main.c
+++ b/drivers/media/i2c/tevs/tevs_main.c
@@ -297,6 +297,13 @@
 #define TOTAL_MICROSEC_PERSEC				(1000000)
 
 #define TEVS_IMG_FORMAT_UYVY				(0x50)
+#define TEVS_IMG_FORMAT_Y8				(0x52)	/* AP1302 YUV_JFIF | YUV_400 */
+#define TEVS_IMG_FORMAT_RAW8_SENSOR			(0x80)	/* AP1302 RAW8 | RAW_SENSOR */
+#define TEVS_IMG_FORMAT_RAW10_SENSOR			(0x90)	/* AP1302 RAW10 | RAW_SENSOR */
+
+static bool bypass_isp = true;
+module_param(bypass_isp, bool, 0644);
+MODULE_PARM_DESC(bypass_isp, "Y8 requests sensor RAW8 (0x80, default) instead of ISP Y-only (0x52, returns black frames on AR0822 fw 25.10.0.1)");
 
 #define TEVS_LINK_FREQUENCY_DEFAULT			400000000ull
 #define TEVS_PIXEL_RATE_DEFAULT				200000000ull
@@ -393,6 +400,35 @@ struct tevs {
 	struct v4l2_ctrl *trigger;
 };
 
+static u16 tevs_preview_format(struct tevs *tevs)
+{
+	if (tevs->fmt.code == MEDIA_BUS_FMT_Y8_1X8)
+		return bypass_isp ? TEVS_IMG_FORMAT_RAW8_SENSOR :
+				    TEVS_IMG_FORMAT_Y8;
+	if (tevs->fmt.code == MEDIA_BUS_FMT_Y10_1X10)
+		return TEVS_IMG_FORMAT_RAW10_SENSOR;
+	return TEVS_IMG_FORMAT_UYVY;
+}
+
+static u16 tevs_preview_mipi_ctrl(struct tevs *tevs)
+{
+	if (tevs->fmt.code == MEDIA_BUS_FMT_Y8_1X8)
+		return (MIPI_CSI2_DT_RAW8 << 2) | tevs->vc_id;
+	if (tevs->fmt.code == MEDIA_BUS_FMT_Y10_1X10)
+		return (MIPI_CSI2_DT_RAW10 << 2) | tevs->vc_id;
+	return tevs->vc_id;
+}
+
+static bool tevs_code_supported(struct tevs *tevs, u32 code)
+{
+	int i;
+
+	for (i = 0; i < tevs_sensor_table[tevs->selected_sensor].code_list_size; i++)
+		if (tevs_sensor_table[tevs->selected_sensor].code_list[i] == code)
+			return true;
+	return false;
+}
+
 static const struct regmap_config tevs_regmap_config = {
 	.reg_bits = 16,
 	.val_bits = 8,
@@ -604,7 +640,7 @@ static int tevs_set_stream(struct v4l2_subdev *sub_dev, int enable)
 					.height);
 			cci_write(tevs->regmap,
 				  HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT,
-				  TEVS_IMG_FORMAT_UYVY, NULL);
+				  tevs_preview_format(tevs), NULL);
 			cci_write(tevs->regmap,
 				  HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
 				  0x10 | (tevs->continuous_clock << 5) |
@@ -612,7 +648,7 @@ static int tevs_set_stream(struct v4l2_subdev *sub_dev, int enable)
 				  NULL);
 			cci_write(tevs->regmap,
 				  HOST_COMMAND_ISP_CTRL_PREVIEW_MIPI_CTRL,
-				  tevs->vc_id, NULL);
+				  tevs_preview_mipi_ctrl(tevs), NULL);
 			cci_write(tevs->regmap,
 				  HOST_COMMAND_ISP_CTRL_PREVIEW_SENSOR_MODE,
 				  tevs_sensor_table[tevs->selected_sensor]
@@ -685,7 +721,7 @@ static int tevs_enum_frame_size(struct v4l2_subdev *sub_dev,
 	     tevs_sensor_table[tevs->selected_sensor].res_list_size))
 		return -EINVAL;
 
-	if (fse->code != tevs_sensor_table[tevs->selected_sensor].code_list[0])
+	if (!tevs_code_supported(tevs, fse->code))
 		return -EINVAL;
 
 	dev_dbg(sub_dev->dev, "%s(), index [%u]\n", __func__, fse->index);
@@ -807,7 +843,8 @@ static int tevs_set_fmt(struct v4l2_subdev *sub_dev,
 		tevs_sensor_table[tevs->selected_sensor].res_list[i].width;
 	mbus_fmt->height =
 		tevs_sensor_table[tevs->selected_sensor].res_list[i].height;
-	mbus_fmt->code = tevs_sensor_table[tevs->selected_sensor].code_list[0];
+	if (!tevs_code_supported(tevs, mbus_fmt->code))
+		mbus_fmt->code = tevs_sensor_table[tevs->selected_sensor].code_list[0];
 	mbus_fmt->field = V4L2_FIELD_NONE;
 	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
 	mbus_fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(mbus_fmt->colorspace);
@@ -943,9 +980,11 @@ static int tevs_get_frame_desc(struct v4l2_subdev *sub_dev, unsigned int pad,
 	fd->entry[0].pixelcode = tevs->fmt.code;
 	fd->entry[0].bus.csi2.vc = 0;
 	fd->entry[0].bus.csi2.dt =
-		tevs->fmt.code == MEDIA_BUS_FMT_SGRBG8_1X8 ?
+		(tevs->fmt.code == MEDIA_BUS_FMT_SGRBG8_1X8 ||
+		 tevs->fmt.code == MEDIA_BUS_FMT_Y8_1X8) ?
 			MIPI_CSI2_DT_RAW8 :
-		tevs->fmt.code == MEDIA_BUS_FMT_SGRBG10_1X10 ?
+		(tevs->fmt.code == MEDIA_BUS_FMT_SGRBG10_1X10 ||
+		 tevs->fmt.code == MEDIA_BUS_FMT_Y10_1X10) ?
 			MIPI_CSI2_DT_RAW10 :
 		tevs->fmt.code == MEDIA_BUS_FMT_SGRBG12_1X12 ?
 			MIPI_CSI2_DT_RAW12 :
@@ -1285,13 +1324,13 @@ static int tevs_set_bsl_mode(struct tevs *tevs, s32 mode)
 		}
 
 		cci_write(tevs->regmap, HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT,
-			  TEVS_IMG_FORMAT_UYVY, NULL);
+			  tevs_preview_format(tevs), NULL);
 		cci_write(tevs->regmap, HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
 			  0x10 | (tevs->continuous_clock << 5) |
 				  (tevs->data_lanes),
 			  NULL);
 		cci_write(tevs->regmap, HOST_COMMAND_ISP_CTRL_PREVIEW_MIPI_CTRL,
-			  tevs->vc_id, NULL);
+			  tevs_preview_mipi_ctrl(tevs), NULL);
 
 		break;
 	case TEVS_BSL_MODE_FLASH_IDX:
@@ -1996,7 +2035,7 @@ static int tevs_power_on(struct tevs *tevs)
 
 		ret += cci_write(tevs->regmap,
 				 HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT,
-				 TEVS_IMG_FORMAT_UYVY, NULL);
+				 tevs_preview_format(tevs), NULL);
 		ret += cci_write(tevs->regmap,
 				 HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
 				 0x10 | (tevs->continuous_clock << 5) |
@@ -2004,7 +2043,7 @@ static int tevs_power_on(struct tevs *tevs)
 				 NULL);
 		ret += cci_write(tevs->regmap,
 				 HOST_COMMAND_ISP_CTRL_PREVIEW_MIPI_CTRL,
-				 tevs->vc_id, NULL);
+				 tevs_preview_mipi_ctrl(tevs), NULL);
 		if (ret)
 			goto error;
 	}
diff --git a/drivers/media/i2c/tevs/tevs_tbls.h b/drivers/media/i2c/tevs/tevs_tbls.h
