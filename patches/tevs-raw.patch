diff --git a/drivers/media/i2c/tevs/tevs_main.c b/drivers/media/i2c/tevs/tevs_main.c
index 0929aa2..16bad71 100644
--- a/drivers/media/i2c/tevs/tevs_main.c
+++ b/drivers/media/i2c/tevs/tevs_main.c
@@ -297,6 +297,10 @@
 #define TOTAL_MICROSEC_PERSEC				(1000000)
 
 #define TEVS_IMG_FORMAT_UYVY				(0x50)
+#define TEVS_IMG_FORMAT_RAW8				(0x80)
+#define TEVS_IMG_FORMAT_RAW10				(0x90)
+#define TEVS_IMG_FORMAT_RAW12				(0xA0)
+#define TEVS_IMG_FORMAT_RAW16				(0xB0)
 
 #define TEVS_LINK_FREQUENCY_DEFAULT			400000000ull
 #define TEVS_PIXEL_RATE_DEFAULT				200000000ull
@@ -393,6 +397,45 @@ struct tevs {
 	struct v4l2_ctrl *trigger;
 };
 
+static bool tevs_is_raw_code(u32 code)
+{
+	return code == MEDIA_BUS_FMT_SGRBG8_1X8 ||
+	       code == MEDIA_BUS_FMT_SGRBG10_1X10 ||
+	       code == MEDIA_BUS_FMT_SGRBG12_1X12 ||
+	       code == MEDIA_BUS_FMT_SGRBG16_1X16;
+}
+
+/* Return @code if the sensor lists it, else the sensor's default code. */
+static u32 tevs_supported_code(struct tevs *tevs, u32 code)
+{
+	const struct sensor_info *info = &tevs_sensor_table[tevs->selected_sensor];
+	int i;
+
+	for (i = 0; i < info->code_list_size; i++)
+		if (info->code_list[i] == code)
+			return code;
+
+	return info->code_list[0];
+}
+
+/* ISP preview output format register value for a media bus code. */
+static u16 tevs_isp_format(u32 code)
+{
+	switch (code) {
+	case MEDIA_BUS_FMT_SGRBG8_1X8:
+		return TEVS_IMG_FORMAT_RAW8;
+	case MEDIA_BUS_FMT_SGRBG10_1X10:
+		return TEVS_IMG_FORMAT_RAW10;
+	case MEDIA_BUS_FMT_SGRBG12_1X12:
+		return TEVS_IMG_FORMAT_RAW12;
+	case MEDIA_BUS_FMT_SGRBG16_1X16:
+		return TEVS_IMG_FORMAT_RAW16;
+	default:
+		return TEVS_IMG_FORMAT_UYVY;
+	}
+}
+
+
 static const struct regmap_config tevs_regmap_config = {
 	.reg_bits = 16,
 	.val_bits = 8,
@@ -604,7 +647,7 @@ static int tevs_set_stream(struct v4l2_subdev *sub_dev, int enable)
 					.height);
 			cci_write(tevs->regmap,
 				  HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT,
-				  TEVS_IMG_FORMAT_UYVY, NULL);
+				  tevs_isp_format(tevs->fmt.code), NULL);
 			cci_write(tevs->regmap,
 				  HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
 				  0x10 | (tevs->continuous_clock << 5) |
@@ -685,7 +728,7 @@ static int tevs_enum_frame_size(struct v4l2_subdev *sub_dev,
 	     tevs_sensor_table[tevs->selected_sensor].res_list_size))
 		return -EINVAL;
 
-	if (fse->code != tevs_sensor_table[tevs->selected_sensor].code_list[0])
+	if (fse->code != tevs_supported_code(tevs, fse->code))
 		return -EINVAL;
 
 	dev_dbg(sub_dev->dev, "%s(), index [%u]\n", __func__, fse->index);
@@ -807,9 +850,10 @@ static int tevs_set_fmt(struct v4l2_subdev *sub_dev,
 		tevs_sensor_table[tevs->selected_sensor].res_list[i].width;
 	mbus_fmt->height =
 		tevs_sensor_table[tevs->selected_sensor].res_list[i].height;
-	mbus_fmt->code = tevs_sensor_table[tevs->selected_sensor].code_list[0];
+	mbus_fmt->code = tevs_supported_code(tevs, mbus_fmt->code);
 	mbus_fmt->field = V4L2_FIELD_NONE;
-	mbus_fmt->colorspace = V4L2_COLORSPACE_SRGB;
+	mbus_fmt->colorspace = tevs_is_raw_code(mbus_fmt->code) ?
+		V4L2_COLORSPACE_RAW : V4L2_COLORSPACE_SRGB;
 	mbus_fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(mbus_fmt->colorspace);
 	mbus_fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
 	mbus_fmt->xfer_func = V4L2_MAP_XFER_FUNC_DEFAULT(mbus_fmt->colorspace);
@@ -1285,7 +1329,7 @@ static int tevs_set_bsl_mode(struct tevs *tevs, s32 mode)
 		}
 
 		cci_write(tevs->regmap, HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT,
-			  TEVS_IMG_FORMAT_UYVY, NULL);
+			  tevs_isp_format(tevs->fmt.code), NULL);
 		cci_write(tevs->regmap, HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
 			  0x10 | (tevs->continuous_clock << 5) |
 				  (tevs->data_lanes),
@@ -1996,7 +2040,7 @@ static int tevs_power_on(struct tevs *tevs)
 
 		ret += cci_write(tevs->regmap,
 				 HOST_COMMAND_ISP_CTRL_PREVIEW_FORMAT,
-				 TEVS_IMG_FORMAT_UYVY, NULL);
+				 tevs_isp_format(tevs->fmt.code), NULL);
 		ret += cci_write(tevs->regmap,
 				 HOST_COMMAND_ISP_CTRL_PREVIEW_HINF_CTRL,
 				 0x10 | (tevs->continuous_clock << 5) |
