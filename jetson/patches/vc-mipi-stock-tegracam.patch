+/*
+ * PATH-Imaging: PATH_STOCK_TEGRACAM builds this driver against NVIDIA's unpatched tegra-camera.ko.
+ * The trigger_mode, io_mode, black_level, single_trigger and binning_mode controls and the crop
+ * origin need Vision Components' patches to nvidia-oot (patch/kernel_Xavier_39.2.0 in
+ * vc_mipi_nvidia), which add members to tegracam_ctrl_ops and sensor_image_properties and so
+ * change the layout tegra-camera.ko is built with. Without them the sensor keeps its defaults:
+ * free run, flash off, default black level, no binning, full frame. Gain, exposure and frame
+ * rate are NVIDIA's own controls and work unchanged.
+ */
+#ifndef PATH_STOCK_TEGRACAM
 static int vc_set_trigger_mode(struct tegracam_device *tc_dev, __s64 val)
 {
         struct vc_cam *cam = tegracam_to_cam(tc_dev);
@@ -450,6 +462,7 @@
         struct vc_cam *cam = tegracam_to_cam(tc_dev);
